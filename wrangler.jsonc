{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "web3wallet-login",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "web3wallet-login",
			"database_id": "2cce415c-ce2b-4935-bc1b-77eb852fbdd1",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
